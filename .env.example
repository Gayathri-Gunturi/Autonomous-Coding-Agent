# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=own_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Optional tuning
MAX_ITERATIONS=3
EXECUTION_TIMEOUT=10
MAX_OUTPUT_BYTES=20000
MAX_MEMORY_MB=512
